/* ---------- Pie de página ---------- */
#site-footer{position:relative!important;width:100vw!important;max-width:none!important;margin:clamp(56px,8vw,110px) 0 0 calc(50% - 50vw)!important;padding:0!important;background:var(--ed-ink)!important;color:#e9dfd3!important;border:0!important;font-family:var(--ed-ui)!important;overflow:hidden}
#site-footer::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(700px 360px at 92% 0%,rgba(164,83,44,.32),transparent 65%),radial-gradient(600px 320px at 0% 100%,rgba(25,120,111,.22),transparent 60%)}
#site-footer a{color:#efe6db!important;text-decoration:none!important}
#site-footer :focus-visible{outline:2px solid var(--ed-accent-light)!important;outline-offset:3px!important;border-radius:6px}
#site-footer .ft-inner{position:relative;max-width:var(--ed-max);margin:0 auto;padding:clamp(48px,7vw,84px) var(--ed-gutter) 0}
#site-footer .ft-top{display:grid;grid-template-columns:minmax(0,2fr) repeat(4,minmax(0,1fr));gap:clamp(28px,4vw,56px);padding-bottom:clamp(40px,5vw,64px)}
