 function render(box){
  var st=box.dataset.step,path=box.dataset.path?box.dataset.path.split(","):[],h="",done=st.indexOf("r:")===0;
  var trail=path.length?'<ol class="fx-det-trail" aria-label="Tus respuestas">'+path.map(function(p){var a=p.split(":");return '<li>'+D.q[a[0]].s+': '+(a[1]==="y"?"sí":"no")+'</li>'}).join("")+'</ol>':"";
  var n=done?5:stepNo(st);
  box.querySelector(".fx-det-prog").innerHTML=ORDER.map(function(_,i){return '<li'+(i<n?' class="on"':'')+'></li>'}).join("");
  var back=path.length?'<button type="button" class="fx-ghost" data-fx-back>← Atrás</button>':'';
  if(done){
   var k=st.slice(2);
   if(k==="none")h=trail+'<div class="fx-det-res"><h5>No aparece una falacia clara</h5><p>El razonamiento parece correcto. Queda la otra mitad del control: comprobar si las premisas son <strong>verdaderas</strong>. Un argumento bien construido con datos falsos tampoco demuestra nada.</p></div>';
   else{var f=D.fams[k];h=trail+'<div class="fx-det-res fx-'+k+'"><h5>'+f.n+' · '+f.h+'</h5><p>Busca entre estas falacias; la pista de cada una te ayuda a elegir. Toca una para abrir su ficha.</p><ul>'+f.m.map(chip).join("")+'</ul></div>'}
   h+='<div class="fx-det-btns"><button type="button" data-fx-restart>Analizar otra frase</button>'+back+'</div>';
  }else{
   h=trail+'<p class="fx-det-n">Pregunta '+stepNo(st)+(st==="q4b"?" · continuación":"")+'</p><p class="fx-det-qt">'+D.q[st].t+'</p><div class="fx-det-btns"><button type="button" data-fx-ans="y">Sí</button><button type="button" data-fx-ans="n">No</button>'+back+'</div>';
  }
  box.querySelector(".fx-det-body").innerHTML=h;
  var b=box.querySelector(".fx-det-body button");b&&b.focus({preventScroll:true});
 }
 function score(qz){var all=qz.querySelectorAll(".fx-q").length,ok=qz.querySelectorAll(".fx-q.is-right").length,done=qz.querySelectorAll(".fx-q.is-done").length;
  var s=qz.querySelector("[data-fx-score]");if(s)s.textContent="Llevas "+ok+" de "+all+(done===all?(ok===all?". ¡Perfecto! Tienes buen ojo.":ok>=all*0.6?". Muy bien; repasa las fichas de las que fallaste.":". Repasa el mapa y vuelve a intentarlo."):".")}
 document.addEventListener("click",function(e){
  var t=e.target;if(!t||!t.closest)return;
  var g=t.closest("#falacias [data-fx-go]");
  if(g){e.preventDefault();e.stopPropagation();go(g.getAttribute("data-fx-go"));return}
  var box=t.closest("#falacias [data-fx-det]");
  if(box){
   var a=t.closest("[data-fx-ans]");
   if(a){var st=box.dataset.step,ans=a.getAttribute("data-fx-ans");box.dataset.path=(box.dataset.path?box.dataset.path+",":"")+st+":"+ans;box.dataset.step=D.q[st][ans];render(box);return}
   if(t.closest("[data-fx-back]")){var p=box.dataset.path.split(",");var last=p.pop();box.dataset.path=p.join(",");box.dataset.step=last.split(":")[0];render(box);return}
   if(t.closest("[data-fx-restart]")){box.dataset.path="";box.dataset.step="q1";render(box);return}
  }
  var o=t.closest("#falacias [data-fx-opt]");
  if(o){var q=o.closest(".fx-q");if(!q||q.classList.contains("is-done"))return;var ok=q.dataset.ok,pick=o.getAttribute("data-fx-opt"),right=pick===ok;
   q.classList.add("is-done");right&&q.classList.add("is-right");
   q.querySelectorAll("[data-fx-opt]").forEach(function(b){b.disabled=true;var id=b.getAttribute("data-fx-opt");b.classList.add(id===ok?"is-ok":id===pick?"is-bad":"is-dim")});
   var fb=q.querySelector(".fx-q-fb");fb.innerHTML='<b>'+(right?"¡Correcto!":"No exactamente: es "+NAMES[ok]+".")+'</b> '+fb.getAttribute("data-exp")+' <a href="#fx-'+ok+'" data-fx-go="fx-'+ok+'">Ver la ficha →</a>';fb.hidden=false;
   score(q.closest("[data-fx-quiz]"));return}
  var r=t.closest("#falacias [data-fx-qreset]");
