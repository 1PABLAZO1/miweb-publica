 #site-header .main-nav .nav-group:hover>.nav-menu[hidden]{display:none!important}
 #site-header .main-nav .nav-group:hover .nav-chevron:not([aria-expanded="true"])::before{transform:none!important}
 #site-header .main-nav .nav-menu{position:static!important;width:auto!important;min-width:0!important;margin:0 0 16px!important;padding:6px!important;box-shadow:none!important;border-radius:16px!important;background:var(--ed-card)!important}
 #site-header .main-nav .nav-menu::before{display:none!important}
 #site-header .main-nav #menu-artículos,#site-header .main-nav #menu-apuntes,#site-header .main-nav #menu-series{width:auto!important}
 #site-header .search-toggle{width:44px!important;padding:0!important;justify-content:center!important;box-shadow:none!important}
