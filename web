(function(){
 "use strict";
 var D={"q": {"q1": {"t": "¿Se juzga la idea por <strong>quién la dice</strong>, de dónde viene o cuánta gente la apoya, en lugar de por sus razones?", "s": "Juzga por la fuente", "y": "r:f1", "n": "q2"}, "q2": {"t": "¿Intenta que <strong>sientas algo</strong> (pena, miedo, culpa) o te presiona, en lugar de darte motivos para creerlo?", "s": "Apela a emociones", "y": "r:f2", "n": "q3"}, "q3": {"t": "¿Ha <strong>cambiado lo que se discute</strong>: se deforma la postura del otro, se salta a otro tema o una palabra cambia de sentido?", "s": "Cambia el debate", "y": "r:f3", "n": "q4"}, "q4": {"t": "¿La conclusión se apoya en <strong>datos, casos, causas o comparaciones</strong>?", "s": "Usa datos o causas", "y": "q4b", "n": "q5"}, "q4b": {"t": "¿Esos datos son <strong>suficientes y representativos</strong>, y se han descartado otras explicaciones?", "s": "Datos suficientes", "y": "q5", "n": "r:f4"}, "q5": {"t": "¿El planteamiento <strong>da por hecho lo que se discute</strong>: solo dos opciones, la conclusión reformulada o que la falta de pruebas ya prueba algo?", "s": "Planteamiento con trampa", "y": "r:f5", "n": "r:none"}}, "fams": {"f1": {"n": "¿Quién lo dice?", "h": "Juzgar la idea por su origen", "m": [{"id": "adhominem", "n": "Ad hominem", "c": "ataca a la persona"}, {"id": "autoridad", "n": "Apelación a la autoridad", "c": "lo dice alguien importante"}, {"id": "multitud", "n": "Apelación a la multitud", "c": "lo hace mucha gente"}, {"id": "tradicion", "n": "Apelación a la tradición", "c": "siempre se ha hecho así"}, {"id": "naturaleza", "n": "Apelación a la naturaleza", "c": "es natural"}]}, "f2": {"n": "¿Qué me hace sentir?", "h": "Presionar en lugar de razonar", "m": [{"id": "emocion", "n": "Apelación a la emoción", "c": "conmueve o asusta"}, {"id": "piedad", "n": "Apelación a la piedad", "c": "pide compasión"}, {"id": "fuerza", "n": "Apelación a la fuerza", "c": "amenaza o presiona"}]}, "f3": {"n": "¿De qué hablábamos?", "h": "Cambiar el debate", "m": [{"id": "hombrepaja", "n": "Hombre de paja", "c": "deforma tu postura"}, {"id": "pistafalsa", "n": "Pista falsa", "c": "cambia de tema"}, {"id": "equivoco", "n": "Equívoco", "c": "una palabra cambia de sentido"}]}, "f4": {"n": "¿Qué dicen los datos?", "h": "Leer mal los datos y las causas", "m": [{"id": "falsacausa", "n": "Falsa causa", "c": "pasó antes, luego lo causó"}, {"id": "causacomun", "n": "Causa común", "c": "van juntos, luego uno causa el otro"}, {"id": "generalizacion", "n": "Generalización apresurada", "c": "pocos casos, regla general"}, {"id": "francotirador", "n": "Francotirador tejano", "c": "solo los datos que convienen"}, {"id": "analogia", "n": "Falsa analogía", "c": "se parecen, luego son iguales"}, {"id": "pendiente", "n": "Pendiente resbaladiza", "c": "un paso lleva al desastre"}]}, "f5": {"n": "¿Qué se da por hecho?", "h": "Premisas con trampa", "m": [{"id": "dicotomia", "n": "Falsa dicotomía", "c": "solo dos opciones"}, {"id": "circular", "n": "Razonamiento circular", "c": "la prueba es la conclusión"}, {"id": "ignorancia", "n": "Apelación a la ignorancia", "c": "no se ha probado lo contrario"}]}}};
 var NAMES={};Object.keys(D.fams).forEach(function(k){D.fams[k].m.forEach(function(x){NAMES[x.id]=x.n})});
 var RM=matchMedia("(prefers-reduced-motion: reduce)");
 function go(id){var t=document.getElementById(id);if(!t)return;t.scrollIntoView({behavior:RM.matches?"auto":"smooth",block:"start"});
  if(t.classList.contains("fx-card")){t.classList.remove("fx-flash");void t.offsetWidth;t.classList.add("fx-flash");setTimeout(function(){t.classList.remove("fx-flash")},1900)}
  if(!t.hasAttribute("tabindex"))t.setAttribute("tabindex","-1");t.focus({preventScroll:true})}
 var ORDER=["q1","q2","q3","q4","q5"];
