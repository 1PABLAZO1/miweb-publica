ector(".nav-menu").setAttribute("hidden",""),e.setAttribute("aria-expanded","false"))})))}()</script><script>!function(){const e=[{id:"vivienda",title:"La crisis de la vivienda en España y el «agujero negro rentista»",text:"La crisis de la vivienda en España y el «agujero negro rentista» ◷ 23 min de lectura Resumen ampliado de un vídeo del economista Henry Fudge, contrastado con fuentes públicas y completado con el contexto a 13 de noviembre de 2026. Actualizado a 13 de noviembre de 2026; datos verificados el 9 de noviembre. La parte legislativa cambia cada semana: el 12 de noviembre se votaron los decretos y el 29 se vota en las urnas. Cada dato del vídeo lleva una marca: Confirmado Corregido No confirmado La tesis en 30 segundos. Según el vídeo, los fondos buitre son solo la guinda de un pastel envenenado. El problema de fondo es un mercado mal diseñado con tres ingredientes: E , oferta rígida; C , dinero y crédito abundantes; y t , impuestos que favorecen poseer y alquilar frente a trabajar. Resultado: la vivienda se vuelve la inversión dominante y los salarios se quedan atrás. El razonamiento del vídeo de un vistazo Figura 1 E Oferta rígida urbanismo lentísimo C Crédito y compras al contado demanda abundante t Fiscalidad favorable a poseer y alquilar ↓ Precios de la vivienda al alza ↓ La vivienda es el activo dominante de los hogares ↓ Agujero negro rentista las rentas de la propiedad pesan más que el trabajo ↓ Salarios y productividad se desacoplan Fondos buitre: «la guinda del pastel», no la causa de fondo Veredicto en una línea. El ingrediente E está muy bien respaldado por datos oficiales (Banco de España, CNMC); t es una idea válida, pero con matices; C es el eslabón más débil; y varias cifras del vídeo no cuadran o no se pueden verificar (hay una tabla de verificación más abajo). ¿Quieres el desglose completo? Hay una versión completa en cinco partes . En este artículo El caso que encendió el debate Cuánto pesan de verdad los fondos Los tres ingredientes: E, C y t E: una oferta que no responde C: crédito t: impuestos La riqueza está en ladrillo Salarios, productividad y PIB Soluciones y estado del debate Verificación de los datos del vídeo Glosario Preguntas de repaso El caso que encendió el debate Maricarmen Abascal, de 87 años, vivía desde 1956 en un piso de alquiler de Madrid. Fue desahuciada el 23 de septiembre de 2026 y murió el 7 de octubre, sin haber podido volver a su casa. Su caso desató las protestas por la vivienda en las grandes ciudades. Cronología del caso de Maricarmen Abascal Figura 2 1956 El padre firma un contrato de renta antigua del piso, en Retiro (Madrid). 2007 Según la Audiencia Provincial, el contrato quedó extinguido: la ley de 1994 limita a dos años la segunda subrogación. 2018 Urbagestión compra el piso y reclama la vivienda; plantea un alquiler de 1.650 € frente a los 440-480 € que ella dice pagar. Mar. 2026 El Tribunal Supremo da la razón a la propiedad. 23 sep Cuarto intento de desahucio : la policía derriba la puerta y la saca en camilla. 26-27 sep Gran marcha en Madrid: 25.000 personas según las autoridades, más de 300.000 según el Sindicato de Inquilinas. 29 sep Acuerdo mediado por el Ayuntamiento: contrato de 8 años con una renta de como máximo el 30 % de sus ingresos netos. 7 oct Fallece tras 15 días hospitalizada, sin haber podido regresar a su casa. Suele contarse como obra de un «fondo buitre», pero la historia es más compleja: ¿Fondo buitre? Corregido Según Maldita.es, Urbagestión es una micropyme: capital social de unos 3.000 €, siete u ocho empleados y menos del 5 % de su actividad en vivienda residencial. El caso ilustra una lógica rentista, no necesariamente la de Blackstone. ¿El 275 %? Corregido Sale de comparar 1.650 € con los 440 € que ella decía pagar. Otros medios hablan de +247 % o +300 %, y la propiedad sostiene que la renta real era de 204 € más gastos. Las cifras están en disputa. La causa jurídica. No fue solo una subida de precio, sino la extinción de un contrato de renta antigua por la ley de 1994, avalada por la Audiencia y el Supremo. Es sobre todo un conflicto de seguridad de tenencia. Bulos. Circularon afirmaciones sobre su patrimonio y su pasado laboral que Maldita.es no pudo verificar: conviene no usarlas. Cuánto pesan de verdad los fondos Los manifestantes culpan a los fondos internacionales. El vídeo cuenta que llegaron tras el rescate bancario (unos 60.000 millones de euros, cifra que se confirma) y la creación de SAREB, el «banco malo», que vendió lotes de viviendas a fondos como Blackstone. Pero su peso en el conjunto del mercado es pequeño. ¿Quién posee el alquiler en España? Figura 3 Alquiler en manos de multiarrendadores, empresas o entes públicos 61 % Alquiler de particulares en manos de caseros con 2 o más viviendas 52,8 % Personas jurídicas en el parque de alquiler (fondos, socimis, aseguradoras…) ≈ 9 % Grandes tenedores privados (más de 110.000 viviendas) ≈ 5 % Cada barra mide una cosa distinta (otra población y otro denominador): no se suman . Fuentes: Ministerio de Vivienda y CSIC (abril de 2026), Banco de España y Atlas Inmobiliario (vía EFE, 29 de septiembre de 2026). Vivienda pública sobre el parque total Figura 4 Países Bajos 34 % Austria 23,6 % Reino Unido 16,4 % España 1,5 % 1 de cada 65 viviendas Fuente: Banco de España, informe de 2025. El «8 % de los hogares» Corregido parece una confusión: ese orden de magnitud se parece al peso de todas las personas jurídicas en el alquiler, no solo de los fondos extranjeros. En Barcelona, las personas jurídicas privadas son el 3 % de los titulares y el 8,1 % de las propiedades residenciales. Blackstone Confirmado : su socimi Testa, junto con Fidere, es el mayor casero privado de España (13.000-17.000 viviendas en alquiler; 30.000-50.000 sumando servicers). En los últimos años ha vendido parte de su cartera. Concentración. Los fondos pesan poco en conjunto pero se concentran en la costa mediterránea, Baleares y Madrid. Los expertos dudan de que sean la causa principal de la subida de los alquileres. Cushman & Wakefield cifra en 2.934 millones su inversión en el primer semestre de 2026, algo por debajo de los «más de 3.000» del vídeo. Los tres ingredientes: E, C y t Ingrediente Qué dice el vídeo Solidez E Elasticidad de la oferta El urbanismo hace que construir responda muy despacio a los precios Alta C Crédito y colateral Hoy no hay una locura crediticia; la mitad se compra al contado Media t Impuestos El alquiler tributa menos que el trabajo Media Idea clave. Cuando la oferta es inelástica (no puede crecer rápido), cualquier aumento de la demanda —más crédito, más dinero extranjero, más ventajas fiscales— no se convierte en más viviendas, sino en precios más altos . E: una oferta que no responde El Banco de España calcula un déficit de unas 750.000 viviendas entre 2021 y 2025, y la CNMC confirma que pasar de suelo rústico a solar tarda de 10 a 15 años, que el suelo supone alrededor del 45 % del coste de la vivienda y que España tiene una de las regulaciones de suelo más restrictivas de la OCDE. Se construye muy por debajo de lo que se necesita Figura 5 Viviendas terminadas al año Entre 2006 y 2008 (media anual) ≈ 650.000 2025 ≈ 92.000 El desajuste de 2025 Hogares nuevos formados ≈ 240.000 Viviendas terminadas ≈ 92.000 Déficit acumulado de vivienda 2021-2025 ≈ 750.000 2028 (proyección del Banco de España) ≈ 1.000.000 El déficit equivale al 3,7 % de los hogares, frente al 1,5 % de Alemania. Otros informes (BBVA Research) citan unas 160.000 terminadas al año con otra definición, pero el diagnóstico no cambia. Fuente: Banco de España, junio de 2026. Error aritmético. Corregido 1,2 millones de hogares menos 474.000 viviendas son unos 730.000, no 790.000. Lo sólido es la horquilla de 730.000 a 755.000. Licencias y plan de Madrid. Confirmado Una licencia tarda 12 meses de media frente a 3 recomendados (Asprima, la patronal de promotores). El plan de 1997 para unas 145.600 viviendas en el sureste existe, pero Corregido 2003 no es el año de aprobación: ese año el Tribunal Superior de Justicia de Madrid anuló parte del plan. Elasticidad de la oferta de vivienda (OCDE) Figura 6 Marca: el 0,19 que el vídeo atribuye al Reino Unido España 0,452 Reino Unido 0,395 Países Bajos 0,186 El vídeo atribuye el 0,19 al Reino Unido, pero ese valor es el de Países Bajos. Además, estas estimaciones (Caldera y Johansson, OCDE) miden cómo reaccionó la construcción a los precios en el pasado : España sale «elástica» por el boom de 1997-2007 y eso no refleja las trabas de hoy. Lo que el vídeo no dice: España llegó a 49,8 millones de habitantes en julio de 2026 (+3,14 millones desde 2018); la vivienda subió un 12,7 % en 2025, la mayor subida anual desde 2007; y un hogar inquilino necesitaría unos 6,8 años de renta íntegra para comprar. Además, el urbanismo depende de comunidades autónomas y ayuntamientos: es un problema de coordinación, no de una sola ley. C: crédito Es el eslabón más débil. El vídeo sostiene que hoy no hay una locura crediticia comparable a la de 1997-2007 y que alrededor de la mitad de las viviendas se compra sin hipoteca. La tendencia a la baja de la deuda es real, pero las cifras concretas varían según la fuente. Deuda de los hogares, en % del PIB: hitos Figura 7 0 % 25 % 50 % 75 % 100 % ≈ 32 % Mediados de los 90 83,9 % 2008 85 % (máx.) Jun. 2010 41,9 % 2.º trim. 2026 vídeo: 43 % Solo se muestran los hitos documentados, no la serie completa, y la distancia horizontal es aproximada. El 41,9 % es el mínimo desde 1999. Fuentes: Funcas, FBBVA y Banco de España. Compras de vivienda sin hipoteca y compradores extranjeros Figura 8 Marca: «la mitad», según el vídeo Compras sin hipoteca (según la fuente) Registradores (enero-septiembre de 2022, media nacional) 30,5 % Notariado (Cataluña, 2024) 49 % INE (2023; el 39,1 % fue con hipoteca) ≈ 61 % Compradores extranjeros, % de las compraventas Registradores, 1.er trimestre de 2026 13,92 % Cifra que da el vídeo 18 % Se parece más a otras épocas: ese era el peso en 2015 (Forbes). Según la fuente, «la mitad al contado» puede ser desde tres de cada diez compras hasta seis de cada diez. La cifra del INE se calcula como 100 − 39,1 %. Importa porque, si mucha demanda no depende de hipotecas, frenar el crédito enfría menos el mercado. Y hay síntomas de que la demanda topa con el límite del bolsillo: las compraventas cayeron un 11,2 % en el primer trimestre de 2026, aun con precios al alza. t: impuestos Alquilar tributa menos que trabajar: el rendimiento neto del alquiler de vivienda habitual se reduce entre un 50 % y un 90 % antes de aplicar el tipo, y además no cotiza a la Seguridad Social. El vídeo lo ilustra con 20.000 € extra a un tipo marginal del 40 %: si vienen del trabajo, el 60 % es para el trabajador; si vienen del alquiler, se queda con el 82 %. ¿Cuánto se queda quien cobra 20.000 € netos? Figura 9 Marca: el 82 % que cita el vídeo Trabajo (tipo marginal del 40 %) 60 % Impuesto: 8.000 € Alquiler con reducción del 50 % (regla general actual) 80 % Base de 10.000 € · impuesto: 4.000 € Alquiler con reducción del 60 % (contratos anteriores al 26 de mayo de 2023) 84 % Base de 8.000 € · impuesto: 3.200 € Alquiler con reducción del 70 % (zona tensionada, inquilino de 18-35 años u otros supuestos) 88 % Base de 6.000 € · impuesto: 2.400 € Alquiler con reducción del 90 % (zona tensionada con rebaja de renta de al menos el 5 %) 96 % Base de 2.000 € · impuesto: 800 € Impuesto = tipo marginal × (1 − reducción) sobre el rendimiento neto. Además, el trabajo cotiza a la Seguridad Social y el alquiler no, y el propietario deduce gastos (análisis propio, sin verificar en esta revisión): la ventaja real es aún mayor. El «82 %». Corregido Corresponde a la reducción del 60 %, que ya no es la general (hoy es del 50 %). La cifra cambia, pero la conclusión se mantiene. Plusvalías «cero». Corregido La exención se aplica sobre todo a la vivienda habitual; un piso de inversión sí tributa, con tipos del 19 % al 30 %. ITP y AJD del 6-13 %. Corregido Rango razonable: el ITP general va del 4 % al 10 %, con Cataluña hasta el 13 % en los tramos altos. Es un impuesto de «atrapamiento» que penaliza la movilidad. IBI sobre la mitad del valor de mercado. Confirmado La norma fija un coeficiente de 0,5; el Supremo matiza que la ley exige que el catastral no supere el valor de mercado. La riqueza está en ladrillo Para el vídeo, la familia media tiene un 77 % de su riqueza en inmuebles y apenas un 3 % en activos financieros: «una sola inversión: sus casas». La idea se sostiene, pero las cifras no cuadran. Composición de la riqueza de los hogares: vídeo frente a datos Figura 10 Vivienda principal Vídeo 42 % Datos 41,7 % Otras propiedades inmobiliarias Vídeo 27 % Datos 28,2 % Total inmobiliario Vídeo 77 % Datos 69,9 % Activos financieros, pensiones y seguros Vídeo 3 % Datos ≈ 20 % Cálculo propio a partir de cifras del Banco de España. Fuente: Encuesta Financiera de las Familias 2022 (Banco de España). Los activos reales suponen ≈ 79 % del total, así que los financieros rondan el 20 %. La media, además, esconde una brecha generacional: el 72,1 % de los hogares es propietario de su vivienda principal, frente a solo el 31,8 % de los menores de 35 años. El mismo mecanismo que enriquece a quien ya tiene casa encarece el acceso a quien busca la primera. Hogares propietarios de su vivienda principal Figura 11 Todos los hogares 72,1 % Hogares de menores de 35 años 31,8 % 37 puntos menos que en 2011 La media esconde una brecha generacional. Fuente: Encuesta Financiera de las Familias 2022. «Uno de cada tres hogares tiene otra vivienda» sigue sin confirmarse: el Banco de España da el 46,8 % para cualquier inmueble distinto de la vivienda principal (incluye garajes, locales y solares), y no hay cifra oficial solo de viviendas. Implicación política (análisis): si la mayoría de los votantes tiene su patrimonio en inmuebles, las reformas que bajen el precio de la vivienda tienen un coste político alto. Salarios, productividad y PIB El vídeo afirma que, desde 1980, la producción real de España ha crecido un 73 % y los salarios reales solo un 49 %, y que, al quitar la vivienda del PIB, la distorsión desaparece por completo. No confirmado El 73 % y el 49 % siguen sin fuente tras tres búsquedas. Lo más cercano es de Eurofound: entre 1980 y 1995 el salario real subió un 14 %, muy por debajo de la productividad. Sí está documentado que la productividad española se frena desde los años noventa. Confirmado El desacople general es real : la OCDE lo documenta en la mayoría de sus países. Corregido Pero la distorsión no «desaparece» : según la OCDE, se reduce al excluir la vivienda, y parte del efecto es un artefacto estadístico, porque el valor añadido inmobiliario incluye alquileres imputados con casi ningún trabajador asociado. Tres mecanismos ayudan a entender la tesis: el PIB sube con los alquileres sin que haya más producción; el capital y el talento prefieren comprar pisos a fundar empresas; y una parte creciente del salario se va a la vivienda, así que el salario disponible crece aún menos. Soluciones y estado del debate El vídeo propone agilizar los permisos urbanísticos, no inyectar crédito masivo en un mercado inelástico y alinear la fiscalidad del alquiler con la del trabajo. Su medida estrella es un impuesto sobre el valor del suelo ( Land Value Tax ): grava el terreno y no lo construido, así que no encarece la vivienda y desincentiva el suelo ocioso. Sus dificultades son separar el valor del suelo del de la edificación, la transición para quienes ya compraron y la oposición de una mayoría de propietarios. Lectura de oferta La del vídeo, la CNMC y los promotores Liberar suelo y acelerar licencias. Ventaja: ataca la causa de fondo. Límite: tarda años y no ayuda a quien sufre hoy. Lectura de protección del inquilino La del Sindicato de Inquilinas y el Gobierno Contratos estables y frenos a desahucios sin alternativa. Ventaja: respuesta inmediata. Críticas: seguridad jurídica y riesgo de que algunos propietarios retiren oferta. Muchos análisis añaden un tercer pilar: más vivienda pública y asequible, hoy un 1,5 % del parque. Estado del debate a 13 de noviembre de 2026 De los decretos a las urnas Figura 12 2 oct El Congreso tumba los decretos del 29 de septiembre con el voto en contra de PP, Vox y Junts. 5 oct Pedro Sánchez adelanta las elecciones generales al 29 de noviembre. 6-8 oct El Gobierno vuelve a aprobar los dos textos con retoques. El RDL 29/2026 entra en vigor el 8. 11 nov Primera huelga general por la vivienda. 12 nov La Diputación Permanente convalida el RDL 29/2026 y deroga el RDL 28/2026. 29 nov Elecciones generales (la campaña arrancó el 13). Medida Qué plantea Estado Plan Estatal de Vivienda 2026-2030 Dotado con 7.000 millones de euros Aprobado; la plataforma OBS lo critica por insuficiente Real Decreto-ley 28/2026 Prórroga automática de 5 años (7 si el arrendador es persona jurídica) e indemnización al inquilino Derogado el 12 de noviembre : el PNV votó con PP, Vox y Junts. No llegó a entrar en vigor Real Decreto-ley 29/2026 Decreto ómnibus: medidas fiscales, vivienda asequible, límites a compras especulativas, protección frente a desahucios y la línea Tu Casa Convalidado el 12 de noviembre (35 votos a favor, 34 en contra); sigue en vigor Elecciones generales Convocadas por Sánchez tras el rechazo de los primeros decretos 29 de noviembre de 2026 Votación del 12 de noviembre en la Diputación Permanente Figura 13 35 a favor 34 en contra A favor: PSOE, Sumar, PNV, ERC, Bildu y Podemos En contra: PP, Vox y Junts Convalidado RDL 29/2026 · decreto general de medidas de vivienda (resultado: 35 a favor, 34 en contra) Derogado RDL 28/2026 · alquileres indefinidos e indemnización al inquilino: el PNV se sumó al «no» de PP, Vox y Junts La Diputación Permanente es el órgano que sigue activo con las Cortes disueltas; el Gobierno tiene allí una aritmética más favorable que en el Pleno. Fuentes: Europa Press (vía Infobae) e idealista/news, 12 de noviembre de 2026. Qué contiene el RDL 29/2026, que sigue en vigor: Desahucios: moratoria hasta el 31 de diciembre de 2030 para personas vulnerables sin alternativa habitacional, con compensación a los propietarios (no a los considerados «fondos buitre»). Compras especulativas: hasta 2030 se limita que determinados grandes tenedores compren viviendas por debajo del 70 % de su tasación. Alquileres: prórroga extraordinaria de hasta dos años para ciertos contratos, límite del 2 % a la actualización de rentas hasta finales de 2027 y alquileres de temporada solo con causa real y hasta 12 meses. Fiscalidad: reducciones del IRPF de hasta el 100 % para propietarios que bajen la renta, deducción del 10 % para inquilinos, recargo del IBI de hasta el 150 % en vivienda vacía de zonas tensionadas e IVA del 10 % para los pisos turísticos. Tu Casa: financiación del ICO al 0 % para la primera vivienda, de hasta 50.000 € y 10 años, dotada con 10.000 millones. Con el RDL 28/2026 cae la renovación automática de los alquileres y la indemnización al inquilino (doce mensualidades o una por año de residencia). Cómo reaccionaron los actores: Gobierno: la ministra de Vivienda, Isabel Rodríguez, defendió que el decreto protege a inquilinos y a pequeños propietarios mientras crece la oferta asequible. El ministro Bustinduy cifró en cinco millones las personas afectadas por la renovación automática (cifra del Gobierno, sin verificar). PNV: apoyó el decreto general y rechazó el de los alquileres indefinidos por considerar desproporcionada la indemnización. PP, Vox y Junts: votaron en contra de ambos. El PP habló de fraude a la democracia porque la Diputación Permanente no refleja al Pleno, y Junts los acusó de populismo electoralista. Sector inmobiliario: advierte de inseguridad jurídica. El portal idealista, parte interesada, afirma que la oferta de alquiler cayó un 19 % en un mes; es un dato del sector, no una estadística oficial. Aviso de fecha. A 13 de noviembre de 2026, el RDL 29/2026 está en vigor y el RDL 28/2026 ha decaído, pero la campaña de las elecciones del 29 de noviembre acaba de empezar. Los decretos se aprueban, caen y se reaprueban cada pocas semanas: comprueba el estado actual antes de citarlos. Verificación de los datos del vídeo De los 27 datos revisados, 11 se confirman, 15 se corrigen (14 por matices o error y 1 por no estar respaldado) y 1 sigue sin poder confirmarse. Los 27 datos del vídeo tras el contraste Figura 14 27 datos 11 · Confirmados 14 · Corregidos (con matices o error) 1 · Corregido: no respaldado (activos financieros 3 %) 1 · No confirmado (PIB +73 % frente a salarios +49 %) Revisado el 31 de octubre y el 9 de noviembre de 2026. Antes de esta revisión había 8 datos sin verificar; ahora queda 1. Dato Estado Comentario Maricarmen: 87 años, unos 70 en el piso, desahucio el 23 de septiembre, muerte el 7 de octubre Confirmado Otras fuentes dicen 71 años en el piso (desde 1956) Subida del alquiler del 275 % Corregido Cifra de partida en disputa (+247 % a +300 %) Propietario «corporativo» / «fondo buitre» Corregido Urbagestión es una micropyme, no un gran fondo Solo el 8 % de los hogares es de fondos extranjeros Corregido Parece el peso de todas las personas jurídicas (≈ 9 %) Blackstone, más de 30.000 viviendas en 2019 Confirmado Orden de magnitud correcto; incluye servicers Rescate bancario de unos 60.000 M€ y SAREB Confirmado 60.718 M€ (Tribunal de Cuentas); revisiones posteriores, más altas Elasticidad de la OCDE: 0,45 (España) y 0,19 (Reino Unido) Corregido España 0,452 es correcto; el 0,19 es de Países Bajos (RU: 0,395) Más de 650.000 viviendas en 2006 Confirmado Banco de España: 650.000 anuales entre 2006 y 2008 Menos de 100.000 viviendas al año hoy Confirmado Banco de España: 90.000-100.000 terminadas 1,2 millones de hogares y 474.000 viviendas desde 2021 Confirmado Coincide con CaixaBank Research Déficit de «al menos 790.000» viviendas Corregido La resta da unos 730.000; el Banco de España estima 750.000 De 10 a 15 años del